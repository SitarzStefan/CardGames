<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CardGames"
        x:Class="CardGames.HistoryWindow"
        Title="Historia Gier" Width="600" Height="450"
        x:DataType="local:HistoryWindow"
        Background="#2C3E50">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="HISTORIA TWOICH GIER"
                   FontSize="24" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,0">
            <Button Content="Zamknij" Width="120" Click="Close_Click"/>
            <Button Content="Wyczysc historie" Background="#E74C3C" Width="150" Click="Clear_Click"/>
        </StackPanel>

        <ScrollViewer>
    <ListBox Name="HistoryList" Background="Transparent" Foreground="White">
        <ListBox.ItemTemplate>
            <!-- Tutaj dodajemy x:DataType -->
            <DataTemplate x:DataType="local:GameHistory">
                <Border BorderBrush="#34495E" BorderThickness="0,0,0,1" Padding="10">
                    <Grid ColumnDefinitions="*, *, *, *">
                        <TextBlock Grid.Column="0" Text="{Binding Date}" />
                        <TextBlock Grid.Column="1" Text="{Binding GameName}" FontWeight="Bold" Foreground="#F1C40F"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerName}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Result}" HorizontalAlignment="Right" Foreground="#2ECC71"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
</ListBox>
        </ScrollViewer>
    </DockPanel>
</Window>