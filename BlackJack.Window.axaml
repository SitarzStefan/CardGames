<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CardGames.BlackjackWindow"
        Width="700"
        Height="500"
        Title="Oczko">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">

        <TextBlock Text="OCZKO"
                   FontSize="28"
                   HorizontalAlignment="Center"/>

        <Image Name="PlayerCardImage"
               Width="150"
               Height="200"/>

        <TextBlock Name="PlayerText"
                   Text="Gracz 1: 0"
                   FontSize="18"
                   HorizontalAlignment="Center"/>

        <TextBlock Name="BotText"
                   Text=""
                   FontSize="18"
                   HorizontalAlignment="Center"/>

        <TextBlock Name="ResultText"
                   Text=""
                   FontSize="22"
                   HorizontalAlignment="Center"/>

        <Button Content="Dobierz karte"
                Click="Hit_Click"/>

        <Button Content="STOP"
                Click="Stop_Click"/>

    </StackPanel>

</Window>