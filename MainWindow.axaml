<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CardGames.MainWindow"
        Width="800"
        Height="600"
        Title="Gry karciane">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="20">

        <TextBlock Text="GRY KARCIANE"
                   FontSize="40"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <Button Content="Oczko "
                Width="250"
                Height="60"
                Click="Blackjack_Click"/>

        <Button Content="Memory"
                Width="250"
                Height="60"
                Click="Memory_Click"/>

        <Button Content="Color Guess"
                Width="250"
                Height="60"
                Click="ThirdGame_Click"/>
    <Button Content="Historia Gier"
            Width="250"
            Height="60"
                Click="ShowHistory_Click"/>


    </StackPanel>

</Window>